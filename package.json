{
  "name": "inboxfoundry",
  "version": "0.1.0",
  "private": true,
  "description": "Find exactly the Gmail conversations and attachments you need and save them locally.",
  "repository": "github:yogakhatri/InboxFoundry-GmailExporter",
  "license": "MIT",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node --test tests/*.test.cjs",
    "validate": "node scripts/validate.mjs",
    "test": "npm run test:unit && npm run validate",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "package": "npm test && node scripts/package.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}

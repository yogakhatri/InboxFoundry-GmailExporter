{
  "manifest_version": 3,
  "name": "InboxFoundry for Gmail",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Find exactly the Gmail conversations and attachments you need and save them to your computer. No account, no server.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["downloads", "scripting", "sidePanel", "storage", "unlimitedStorage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "action": {
    "default_title": "Open InboxFoundry",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
